<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns="http://www.w3.org/ns/widgets" xmlns:tizen="http://tizen.org/ns/widgets" id="https://github.com/SanuSanal/YouPipe-TV" version="0.1.0" viewmodes="maximized">
    <tizen:application id="YouPipeTV1.YouPipe" package="YouPipeTV1" required_version="7.0"/>
    <tizen:profile name="tv-samsung"/>
    <content src="index.html"/>
    <icon src="icon.png"/>
    <name>YouPipe</name>
    <feature name="http://tizen.org/feature/screen.size.all"/>
    <!-- YouTube is called straight from the TV (docs/architecture.md): every origin the app talks to is listed here. -->
    <tizen:privilege name="http://tizen.org/privilege/internet"/>
    <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>
    <access origin="https://www.youtube.com" subdomains="true"/>
    <access origin="https://youtube.com" subdomains="true"/>
    <access origin="https://googlevideo.com" subdomains="true"/>
    <access origin="https://ytimg.com" subdomains="true"/>
    <access origin="https://ggpht.com" subdomains="true"/>
    <access origin="https://googleusercontent.com" subdomains="true"/>
    <access origin="https://suggestqueries.google.com" subdomains="false"/>
    <access origin="https://sponsor.ajay.app" subdomains="false"/>
    <access origin="https://returnyoutubedislikeapi.com" subdomains="false"/>
    <access origin="https://api.github.com" subdomains="false"/>
    <tizen:setting screen-orientation="landscape" context-menu="disable" background-support="disable" encryption="disable" install-location="auto" hwkey-event="enable"/>
</widget>
